<?xml-model href="teipublisher_odds.xsd"?><?teipublisher output="web print epub fo markdown docx"?><TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:pb="http://teipublisher.com/1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title> Processing Model for Docbook v5 <desc>Processing of Docbook format</desc>
                </title>
                <title type="short">Docbook v5 </title>
            </titleStmt>
            <publicationStmt>
                <publisher>e-editiones</publisher>
                <availability>
                    <licence target="https://creativecommons.org/licenses/by/4.0/">Distributed under a
                        Creative Commons Attribution 4.0 International License</licence>
                    <p>Copyright 2017–2026 <ref target="https://e-editiones.org">e-editiones</ref> and
                        individual contributors.</p>
                    <p>Based on TEI materials © TEI Consortium (CC BY 3.0 / BSD-2-Clause).</p>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p> Generated by <ref target="http://tei-publisher.com">TEI Publisher</ref>
                </p>
                <p>born digital</p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <tagsDecl>
                <rendition source="docbook.css"/>
            </tagsDecl>
        </encodingDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" ident="docbook" ns="http://docbook.org/ns/docbook">
                <elementSpec ident="article">
                    <model output="latex" behaviour="block">
                        <param name="image-dir" value="$parameters?image-dir"/>
                        <param name="styles" value="string-join($config(&#34;latex-styles&#34;), '&amp;#10;')"/>
                        <param name="fontSize" value="($config?font-size, &#34;11pt&#34;)[1]"/>
                        <param name="class" value="($config?class, &#34;article&#34;)[1]"/>
                        <pb:template xmlns="" xml:space="preserve">\documentclass[english,a4paper,[[fontSize]]]{[[class]]}
\usepackage[english]{babel}
\usepackage{colortbl}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage{listings}
\usepackage{graphicx}
\usepackage{mdframed}
\usepackage[export]{adjustbox}
\usepackage{hyperref}
\usepackage{longtable}
\usepackage{tabu}

\pagestyle{fancy}

\definecolor{myblue}{rgb}{0,0.1,0.6}
\definecolor{mygray}{rgb}{0.5,0.5,0.5}
\definecolor{mymauve}{rgb}{0.58,0,0.82}

\lstset{
  basicstyle=\small\ttfamily,
  columns=flexible,
  keepspaces=true,
  breaklines=true,
  keywordstyle=\color{myblue}
}
\lstloadlanguages{xml}

\def\Gin@extensions{.pdf,.png,.jpg,.mps,.tif}
\graphicspath{{[[image-dir]]/doc/}}

[[styles]]

\begin{document}
[[content]]
\end{document}</pb:template>
                    </model>
                    <model predicate="$parameters?mode='summary'" behaviour="block">
                        <param name="content" value="info"/>
                    </model>
                    <model predicate="$parameters?mode='title'" behaviour="block">
                        <param name="content" value="info"/>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <desc>Static/OPM TOC: top-level sections (live TOC uses nav:toc-entry)</desc>
                        <param name="content" value="section"/>
                        <pb:template xml:space="preserve"><ul xmlns="">[[content]]</ul></pb:template>
                    </model>
                    <model behaviour="document"/>
                </elementSpec>
                <elementSpec ident="info">
                    <model output="typst" predicate="parent::article|parent::book" behaviour="pass-through"/>
                    <model output="print" predicate="parent::article|parent::book" behaviour="block" cssClass="frontmatter">
                        <param name="content" value="(title, if ($parameters?skipAuthors) then () else author, pubdate, abstract)"/>
                    </model>
                    <model output="latex" predicate="parent::article|parent::book" behaviour="inline">
                        <param name="content" value="title"/>
                        <param name="author" value="author"/>
                        <pb:template xmlns="" xml:space="preserve">[[content]] \author{[[author]]}
\maketitle</pb:template>
                    </model>
                    <model predicate="$parameters?mode='title'" behaviour="block">
                        <param name="content" value="title"/>
                    </model>
                    <model predicate="not(parent::article or parent::book)" behaviour="block"/>
                    <model output="epub" behaviour="block">
                        <param name="content" value="(title, author)"/>
                    </model>
                    <modelSequence predicate="$parameters?display='browse'">
                        <model behaviour="heading">
                            <param name="content" value="title"/>
                            <param name="level" value="5"/>
                        </model>
                        <model predicate="author" behaviour="block">
                            <param name="content" value="author"/>
                        </model>
                        <model behaviour="block" cssClass="sample-description">
                            <param name="content" value="abstract"/>
                        </model>
                    </modelSequence>
                    <model behaviour="block">
                        <param name="content" value="(title, if ($parameters?skipAuthors) then () else author, pubdate, abstract)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="author">
                    <model output="typst" behaviour="metadata">
                        <param name="key" value="'authors'"/>
                        <param name="content" value="(personname, orgname, affiliation)"/>
                    </model>
                    <model output="latex" predicate="preceding-sibling::author" behaviour="inline">
                        <param name="content" value="(personname, affiliation)"/>
                        <pb:template xml:space="preserve">\and [[content]]</pb:template>
                    </model>
                    <model output="latex" behaviour="inline">
                        <param name="content" value="(personname, affiliation)"/>
                        <pb:template xml:space="preserve">[[content]]</pb:template>
                    </model>
                    <model predicate="preceding-sibling::author and not($parameters?skipAuthors)" behaviour="inline">
                        <param name="content" value="(', ', personname, affiliation)"/>
                    </model>
                    <model predicate="not($parameters?skipAuthors)" behaviour="inline">
                        <param name="content" value="(personname, affiliation)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="personname">
                    <model behaviour="inline" predicate="firstname">
                        <param name="content" value="(firstname, ' ', surname)"/>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="orgname">
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="affiliation">
                    <model behaviour="inline">
                        <param name="content" value="(', ', .)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="title">
                    <model output="typst" predicate="parent::info" behaviour="metadata">
                        <param name="key" value="'title'"/>
                    </model>
                    <model output="typst" behaviour="heading">
                        <param name="level" value="count(ancestor::section)"/>
                    </model>
                    <model output="latex" predicate="parent::info" behaviour="inline">
                        <pb:template xml:space="preserve">\title{[[content]]}</pb:template>
                    </model>
                    <model predicate="$parameters?mode='title'" behaviour="inline"/>
                    <model output="opm-web" predicate="$parameters?mode='breadcrumb' and ../@xml:id and parent::section/section and not($parameters?root is ..)" behaviour="listItem">
                        <desc>Ancestor section — link to the chunk that owns @xml:id</desc>
                        <param name="id" value="../@xml:id"/>
                        <pb:template xml:space="preserve"><a xmlns="" href="#[[id]]">[[content]]</a></pb:template>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='breadcrumb'" behaviour="listItem">
                        <desc>Document title or current chunk — not a link</desc>
                    </model>
                    <model predicate="$parameters?mode='breadcrumb' and not(parent::section)" behaviour="listItem">
                        <pb:template xml:space="preserve"><a xmlns="" href="../browse.html?collection=doc">[[content]]</a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='breadcrumb' and $parameters?root is .." behaviour="listItem"/>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="listItem">
                        <param name="id" value="../@xml:id"/>
                        <param name="hash" value="../@xml:id"/>
                        <pb:template xml:space="preserve"><pb-link xmlns="" xml-id="[[id]]" hash="[[hash]]" emit="transcription">[[content]]</pb-link></pb:template>
                    </model>
                    <model predicate="$parameters?mode='summary'" behaviour="block" cssClass="articletitle">
                        <param name="content" value="node()"/>
                        <param name="path" value="$parameters?path"/>
                        <pb:template xml:space="preserve">
                            <h1 xmlns="">
                                <pb-link path="[[path]]" emit="transcription">[[content]]</pb-link>
                            </h1>
                        </pb:template>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc'" behaviour="inline">
                        <desc>Label only; section opm-web TOC models wrap pb-link</desc>
                    </model>
                    <model predicate="$parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="parent::note" behaviour="heading">
                        <param name="level" value="4"/>
                    </model>
                    <model predicate="parent::info and $parameters?display='browse'" behaviour="link">
                        <param name="uri" value="$parameters?doc"/>
                    </model>
                    <model predicate="parent::info" behaviour="heading" cssClass="doc-title"/>
                    <model behaviour="heading" cssClass="title">
                        <param name="level" value="if ($parameters?view='single') then count(ancestor::section) + 1 else count($get(.)/ancestor::section)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="section">
                    <model output="opm-web" predicate="$parameters?mode='breadcrumb'" behaviour="pass-through">
                        <param name="content" value="(($parameters?root)/ancestor::article/info/title, ($parameters?root)/ancestor::section/title, title)"/>
                        <pb:template xmlns="" xml:space="preserve"><nav aria-label="breadcrumb">
  <ul>[[ content ]]</ul>
</nav></pb:template>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='title'" behaviour="inline">
                        <param name="content" value="string-join((($parameters?root)/ancestor::article/info/title, ($parameters?root)/ancestor::section/title, title), ' – ')"/>
                    </model>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="pass-through">
                        <param name="content" value="($get(.)/ancestor::article/info/title, $get(.)/ancestor::section/title, title)"/>
                        <pb:template xmlns="" xml:space="preserve"><nav aria-label="breadcrumb">
  <ul>[[ content ]]</ul>
</nav></pb:template>
                    </model>
                    <model predicate="$parameters?mode='title'" behaviour="inline">
                        <param name="content" value="string-join(($get(.)/ancestor::article/info/title, $get(.)/ancestor::section/title, title), ' – ')"/>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc' and section and not($parameters?collapse)" behaviour="pass-through">
                        <desc>Static/OPM TOC: nested, expanded (live TOC uses nav:toc-entry)</desc>
                        <param name="id" value="@xml:id"/>
                        <param name="heading" value="title"/>
                        <param name="children" value="section"/>
                        <param name="target" value="($parameters?target, 'transcription')[1]"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <details open="open">
    <summary>
      <pb-link xml-id="[[id]]" node-id="[[id]]" emit="[[target]]" subscribe="[[target]]">[[heading]]</pb-link>
    </summary>
    <ul>[[children]]</ul>
  </details>
</li></pb:template>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc' and section and $parameters?collapse" behaviour="pass-through">
                        <desc>Static/OPM TOC: nested, collapsed</desc>
                        <param name="id" value="@xml:id"/>
                        <param name="heading" value="title"/>
                        <param name="children" value="section"/>
                        <param name="target" value="($parameters?target, 'transcription')[1]"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <details>
    <summary>
      <pb-link xml-id="[[id]]" node-id="[[id]]" emit="[[target]]" subscribe="[[target]]">[[heading]]</pb-link>
    </summary>
    <ul>[[children]]</ul>
  </details>
</li></pb:template>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <desc>Static/OPM TOC: leaf entry</desc>
                        <param name="id" value="@xml:id"/>
                        <param name="heading" value="title"/>
                        <param name="target" value="($parameters?target, 'transcription')[1]"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <pb-link xml-id="[[id]]" node-id="[[id]]" emit="[[target]]" subscribe="[[target]]">[[heading]]</pb-link>
</li></pb:template>
                    </model>
                    <model output="print" behaviour="section"/>
                    <model output="opm-web" behaviour="block">
                        <desc>xml:id stand-in for util:node-id so TOC highlighting works offline (OPM only)</desc>
                        <param name="root" value="@xml:id"/>
                        <param name="nodeId" value="@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <pb-observable data="[[root]],[[nodeId]]" emit="transcription">[[content]]</pb-observable>
                        </pb:template>
                    </model>
                    <model output="web" behaviour="block">
                        <param name="root" value="util:node-id($parameters?root)"/>
                        <param name="nodeId" value="util:node-id($get(.))"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <pb-observable data="[[root]],[[nodeId]]" emit="transcription">[[content]]</pb-observable>
                        </pb:template>
                    </model>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="para">
                    <model output="docx" predicate="../*[1] is ." behaviour="inline"/>
                    <model behaviour="paragraph"/>
                </elementSpec>
                <elementSpec ident="emphasis">
                    <model predicate="@role='bold'" behaviour="inline">
                        <outputRendition xml:space="preserve">
















            font-weight: bold;
font-style: italic;

















            </outputRendition>
                    </model>
                    <model behaviour="inline">
                        <outputRendition xml:space="preserve">
            font-style: italic;
            </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="code">
                    <model output="markdown" behaviour="inline">
                        <pb:template xml:space="preserve">`[[content]]`</pb:template>
                    </model>
                    <model output="latex" behaviour="inline">
                        <pb:template xml:space="preserve">\texttt{[[content]]}</pb:template>
                    </model>
                    <model output="docx" behaviour="inline" cssClass="CodeChar"/>
                    <model output="typst" behaviour="pass-through">
                        <pb:template xml:space="preserve">`[[content]]`</pb:template>
                    </model>
                    <model behaviour="inline" cssClass="code"/>
                </elementSpec>
                <elementSpec ident="figure">
                    <model output="latex" predicate="mediaobject/imageobject/imagedata[ends-with(@fileref, '.gif')]" behaviour="omit"/>
                    <model predicate="title|info/title" behaviour="figure" cssClass="figure">
                        <param name="title" value="title/node()|info/title/node()"/>
                        <param name="content" value="*[not(self::title|self::info)]"/>
                    </model>
                    <model behaviour="figure"/>
                </elementSpec>
                <elementSpec ident="informalfigure">
                    <model predicate="caption" behaviour="figure" cssClass="figure">
                        <param name="title" value="caption/node()"/>
                        <param name="content" value="*[not(self::caption)]"/>
                    </model>
                    <model behaviour="figure" cssClass="figure"/>
                </elementSpec>
                <elementSpec ident="imagedata">
                    <model output="latex" behaviour="graphic">
                        <param name="url" value="@fileref"/>
                        <outputRendition xml:space="preserve">
            max-width: 100%;
            </outputRendition>
                    </model>
                    <model predicate="$parameters?static" behaviour="graphic">
                        <param name="url" value="$parameters?context-path || '/images/' || @fileref"/>
                        <param name="width" value="@width"/>
                        <outputRendition xml:space="preserve">
            max-width: 100%;
            </outputRendition>
                    </model>
                    <model behaviour="graphic">
                        <param name="url" value="@fileref"/>
                        <param name="width" value="@width"/>
                        <outputRendition xml:space="preserve">
            max-width: 100%;
            </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="itemizedlist">
                    <model behaviour="list">
                        <param name="content" value="listitem"/>
                    </model>
                </elementSpec>
                <elementSpec ident="listitem">
                    <model output="docx" predicate="parent::varlistentry" behaviour="inline"/>
                    <model output="typst" predicate="parent::varlistentry" behaviour="inline"/>
                    <model behaviour="listItem"/>
                </elementSpec>
                <elementSpec ident="orderedlist">
                    <model behaviour="list">
                        <param name="type" value="'ordered'"/>
                        <param name="content" value="listitem"/>
                    </model>
                </elementSpec>
                <elementSpec ident="procedure">
                    <model behaviour="list">
                        <param name="type" value="'ordered'"/>
                        <param name="content" value="step"/>
                    </model>
                </elementSpec>
                <elementSpec ident="step">
                    <model behaviour="listItem"/>
                </elementSpec>
                <elementSpec ident="variablelist">
                    <model behaviour="list" output="docx"/>
                    <model output="typst" behaviour="list">
                        <pb:template>
                            #grid(
                                columns: (4cm, 1fr),
                                column-gutter: 1em,
                                row-gutter: 0.6em,
                                [[content]]
                            )
                        </pb:template>
                    </model>
                    <model output="latex" behaviour="block">
                        <param name="content" value="varlistentry"/>
                        <pb:template xml:space="preserve">\begin{description}
[[content]]
\end{description}</pb:template>
                    </model>
                    <model output="fo" behaviour="pass-through">
                        <param name="content" value="varlistentry"/>
                        <pb:template xml:space="preserve">
                            <fo:block xmlns:fo="http://www.w3.org/1999/XSL/Format">[[content]]</fo:block>
                        </pb:template>
                    </model>
                    <model behaviour="pass-through">
                        <param name="content" value="varlistentry"/>
                        <pb:template xml:space="preserve">
                            <dl xmlns="">[[content]]</dl>
                        </pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="varlistentry">
                    <model output="docx" behaviour="listItem">
                        <param name="content" value="(term, listitem)"/>
                    </model>
                    <model output="typst" behaviour="block">
                        <param name="term" value="term"/>
                        <param name="definition" value="listitem"/>
                        <pb:template>
                            [*[[term]]*], [[[definition]]],
                        </pb:template>
                    </model>
                    <model output="latex" behaviour="block">
                        <param name="term" value="term/node()"/>
                        <param name="content" value="listitem/node()"/>
                        <pb:template xml:space="preserve">\item [[[term]]] [[content]]</pb:template>
                    </model>
                    <model output="fo" behaviour="pass-through">
                        <param name="term" value="term/node()"/>
                        <param name="content" value="listitem/node()"/>
                        <pb:template xml:space="preserve">
                            <fo:block xmlns:fo="http://www.w3.org/1999/XSL/Format">[[content]]</fo:block>
                        </pb:template>
                    </model>
                    <model behaviour="pass-through">
                        <param name="term" value="term/node()"/>
                        <param name="content" value="listitem/node()"/>
                        <pb:template xml:space="preserve">
                            <dt xmlns="">[[term]]</dt>
                            <dd xmlns="">[[content]]</dd>
                        </pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="term" mode="add">
                    <model predicate="parent::varlistentry" behaviour="inline" output="docx">
                        <param name="content" value="(., ': ')"/>
                    </model>
                    <model predicate="parent::varlistentry" behaviour="inline" output="typst">
                        <param name="content" value="(., ': ')"/>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="table" mode="add">
                    <modelSequence predicate="title">
                        <model behaviour="heading">
                            <param name="content" value="title"/>
                        </model>
                        <model behaviour="table">
                            <param name="content" value=".//tr"/>
                            <param name="columns" value="max(.//tr ! count(td))"/>
                        </model>
                    </modelSequence>
                    <model behaviour="table" cssClass="table">
                        <param name="content" value=".//tr"/>
                        <param name="columns" value="max(.//tr ! count(td))"/>
                    </model>
                </elementSpec>
                <elementSpec ident="informaltable" mode="add">
                    <model behaviour="table" cssClass="table">
                        <param name="content" value=".//tr"/>
                        <param name="columns" value="max(.//tr ! count(td))"/>
                    </model>
                </elementSpec>
                <elementSpec ident="tr">
                    <model behaviour="row"/>
                </elementSpec>
                <elementSpec ident="td">
                    <model predicate="parent::tr/parent::thead" behaviour="cell">
                        <outputRendition xml:space="preserve">
            font-weight: bold;
            </outputRendition>
                    </model>
                    <model behaviour="cell"/>
                </elementSpec>
                <elementSpec ident="programlisting">
                    <model output="docx" behaviour="block" cssClass="Code"/>
                    <model output="typst" behaviour="code">
                        <param name="language" value="@language"/>
                    </model>
                    <model output="markdown" behaviour="code">
                        <param name="language" value="@language"/>
                    </model>
                    <model output="epub" behaviour="block">
                        <param name="content" value="text()"/>
                        <outputRendition xml:space="preserve">






            font-family: monospace;
margin: 1em 0 1em .5em;
padding: 1em 0 1em .5em;
white-space: pre-wrap;






            </outputRendition>
                    </model>
                    <model output="latex" behaviour="block">
                        <desc>Code listing</desc>
                        <param name="language" value="if (@language = ('xml', 'html', 'sh', 'bash')) then '[language=' || @language || ']' else ()"/>
                        <param name="code" value="replace($content, '^\s*(.*?)$', '$1')"/>
                        <pb:template xml:space="preserve">\begin{lstlisting}[[language]]
[[code]]
\end{lstlisting} </pb:template>
                    </model>
                    <modelGrp output="web">
                        <model predicate="@role='codepen'" behaviour="webcomponent">
                            <param name="hash" value="substring-after(@xlink:href, '#')"/>
                            <param name="user" value="substring-before(@xlink:href, '#')"/>
                            <param name="name" value="'pb-codepen'"/>
                            <param name="theme" value="'dark'"/>
                            <param name="height" value="480"/>
                            <param name="editable" value="true()"/>
                        </model>
                        <model predicate="parent::cell|parent::para|parent::ab" behaviour="inline" cssClass="code"/>
                        <model behaviour="webcomponent">
                            <param name="name" value="'pb-code-highlight'"/>
                            <param name="language" value="(@language, 'xml')[1]"/>
                            <param name="content" value="text()"/>
                            <param name="line-numbers" value="false()"/>
                        </model>
                    </modelGrp>
                    <model behaviour="block" cssClass="programlisting"/>
                </elementSpec>
                <elementSpec ident="synopsis">
                    <model output="markdown" behaviour="code">
                        <param name="language" value="@language"/>
                    </model>
                    <model output="typst" behaviour="code">
                        <param name="language" value="@language"/>
                    </model>
                    <model output="epub" behaviour="block">
                        <param name="content" value="text()"/>
                        <outputRendition xml:space="preserve">






            font-family: monospace;
margin: 1em 0 1em .5em;
padding: 1em 0 1em .5em;
white-space: pre-wrap;






            </outputRendition>
                    </model>
                    <model output="latex" behaviour="block">
                        <desc>Code listing</desc>
                        <param name="language" value="if (@language = ('xml', 'html', 'sh', 'bash')) then '[language=' || @language || ']' else ()"/>
                        <param name="code" value="replace($content, '^\s*(.*?)$', '$1')"/>
                        <pb:template xml:space="preserve">\begin{lstlisting}[[language]]
[[code]]
\end{lstlisting} </pb:template>
                    </model>
                    <model output="print" behaviour="block" cssClass="programlisting"/>
                    <model output="docx" behaviour="block" cssClass="Code"/>
                    <model behaviour="webcomponent">
                        <param name="name" value="'pb-code-highlight'"/>
                        <param name="language" value="@language"/>
                        <param name="content" value="text()"/>
                    </model>
                </elementSpec>
                <elementSpec ident="example">
                    <model behaviour="figure">
                        <param name="title" value="info/title/node()|title/node()"/>
                        <param name="content" value="*[not(self::title|self::info)]"/>
                    </model>
                </elementSpec>
                <elementSpec ident="function">
                    <model output="docx" behaviour="inline" cssClass="CodeChar"/>
                    <model behaviour="inline" cssClass="code"/>
                </elementSpec>
                <elementSpec ident="command">
                    <model output="markdown" behaviour="inline">
                        <pb:template xml:space="preserve">`[[content]]`</pb:template>
                    </model>
                    <model output="docx" behaviour="inline" cssClass="CodeChar"/>
                    <model behaviour="inline" cssClass="code"/>
                </elementSpec>
                <elementSpec ident="parameter">
                    <model output="docx" behaviour="inline" cssClass="CodeChar"/>
                    <model behaviour="inline" cssClass="code"/>
                </elementSpec>
                <elementSpec ident="filename">
                    <model output="docx" behaviour="inline" cssClass="CodeChar"/>
                    <model behaviour="inline" cssClass="code"/>
                </elementSpec>
                <elementSpec ident="note">
                    <model output="docx" behaviour="block" cssClass="Alert"/>
                    <model output="epub" behaviour="block">
                        <outputRendition xml:space="preserve">





            border-top: 1px solid #C0C4C0;
border-bottom: 1px solid #C0C4C0;
margin: 1em 0 1em .5em;
padding: 1em 0 1em .5em;
-webkit-column-break-inside: avoid; /* Chrome, Safari, Opera */
          page-break-inside: avoid; /* Firefox */
               break-inside: avoid; /* IE 10+ */





            </outputRendition>
                    </model>
                    <model output="latex" behaviour="inline">
                        <param name="title" value="title"/>
                        <param name="content" value="*[not(self::title)]"/>
                        <pb:template xml:space="preserve">\begin{mdframed}[frametitle={[[title]]}]
[[content]]
\end{mdframed}</pb:template>
                    </model>
                    <model predicate="@role='todo'" behaviour="inline">
                        <outputRendition xml:space="preserve">
            color: red;
            </outputRendition>
                    </model>
                    <model output="typst" predicate="@role='todo'" behaviour="note">
                        <outputRendition xml:space="preserve">
            color: red;
            </outputRendition>
                    </model>
                    <model output="typst" behaviour="block" cssClass="note">
                        <param name="content" value="(title, *[not(self::title)])"/>
                    </model>
                    <model output="web" behaviour="block" cssClass="note">
                        <param name="content" value="(title, *[not(self::title)])"/>
                    </model>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="remark">
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="tag">
                    <model output="docx" behaviour="inline" cssClass="CodeChar"/>
                    <model behaviour="inline" cssClass="code">
                        <outputRendition xml:space="preserve" scope="before">
            content: '&lt;';
            </outputRendition>
                        <outputRendition xml:space="preserve" scope="after">
            content: '&gt;';
            </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="link">
                    <model output="epub" predicate="@role='source'" behaviour="inline">
                        <param name="uri" value="@xlink:href"/>
                    </model>
                    <model output="web" predicate="@role='source'" behaviour="inline">
                        <param name="path" value="@xlink:href"/>
                        <pb:template xml:space="preserve">
                            <pb-edit-xml xmlns="" path="/db/apps/tei-publisher/[[path]]">
                                [[content]]
                                <iron-icon icon="icons:open-in-new"/>
                            </pb-edit-xml>
                        </pb:template>
                    </model>
                    <model predicate="@linkend" behaviour="webcomponent">
                        <param name="uri" value="concat('?odd=', request:get-parameter('odd', ()), '&amp;amp;view=',                             request:get-parameter('view', ()), '&amp;amp;id=', @linkend)"/>
                        <param name="name" value="'pb-link'"/>
                        <param name="xml-id" value="@linkend"/>
                        <param name="emit" value="'transcription'"/>
                    </model>
                    <model predicate="@xlink:show='new'" behaviour="link">
                        <param name="uri" value="@xlink:href"/>
                        <param name="target" value="'_new'"/>
                    </model>
                    <model behaviour="link">
                        <param name="uri" value="@xlink:href"/>
                    </model>
                </elementSpec>
                <elementSpec ident="*">
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="guibutton" mode="add">
                    <model output="docx" behaviour="inline" cssClass="Button"/>
                    <model behaviour="inline" cssClass="guibutton"/>
                </elementSpec>
                <elementSpec ident="guilabel" mode="add">
                    <model output="docx" behaviour="inline" cssClass="Label"/>
                    <model behaviour="inline" cssClass="guilabel"/>
                </elementSpec>
                <elementSpec ident="videodata" mode="add">
                    <model output="latex" behaviour="block">
                        <param name="content" value="@fileref"/>
                        <pb:template xml:space="preserve">\begin{center}
Not available in PDF edition. Go to \url{[[content]]} to view.
\end{center}</pb:template>
                    </model>
                    <model behaviour="pass-through">
                        <param name="width" value="@width"/>
                        <param name="height" value="@depth"/>
                        <param name="src" value="@fileref"/>
                        <pb:template xml:space="preserve">
                            <iframe xmlns="" src="[[src]]" width="[[width]]" height="[[height]]" frameborder="0" gesture="media" allow="encrypted-media" allowfullscreen="allowfullscreen"/>
                        </pb:template>
                        <outputRendition xml:space="preserve">
            max-width: 100%;
            </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="mediaobject" mode="add">
                    <model output="latex" predicate="imageobject/imagedata[ends-with(@fileref, '.gif')]" behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="abstract" mode="add">
                    <model output="typst" behaviour="metadata">
                        <param name="key" value="'abstract'"/>
                    </model>
                    <model predicate="$parameters?path = $parameters?active" behaviour="omit"/>
                    <model behaviour="block">
                        <outputRendition xml:space="preserve">






            color: #909090;
padding-left: 10px;
border-left: 3px solid #c0c0c0;






            </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="pubdate" mode="add">
                    <model behaviour="inline" cssClass="pubdate">
                        <param name="content" value="format-date(., '[MNn] [D1], [Y0001]', 'en_US', (), ())"/>
                        <outputRendition xml:space="preserve">
            color: #808080;
            </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="footnote" mode="add">
                    <model behaviour="note"/>
                </elementSpec>
                <elementSpec ident="productname" mode="add">
                    <model behaviour="inline">
                        <outputRendition xml:space="preserve">
            font-style: italic;
            </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="guimenuitem" mode="add">
                    <model behaviour="inline" cssClass="guimenuitem"/>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>